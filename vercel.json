{
  "rewrites": [
    { "source": "/wp-admin/:path*", "destination": "/__not_found__" },
    { "source": "/wp-login.php", "destination": "/__not_found__" },
    { "source": "/wp-json/:path*", "destination": "/__not_found__" },
    { "source": "/xmlrpc.php", "destination": "/__not_found__" },
    { "source": "/wp-includes/:path*", "destination": "/__not_found__" },
    { "source": "/wp-content/:path*", "destination": "/__not_found__" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
