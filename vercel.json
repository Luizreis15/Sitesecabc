{
  "routes": [
    { "src": "^/wp-admin(/.*)?$", "status": 404 },
    { "src": "^/wp-login\\.php$", "status": 404 },
    { "src": "^/wp-json(/.*)?$", "status": 404 },
    { "src": "^/xmlrpc\\.php$", "status": 404 },
    { "src": "^/wp-includes(/.*)?$", "status": 404 },
    { "src": "^/wp-content(/.*)?$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
